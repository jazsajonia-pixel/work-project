GSCHPT_DB_PATH=./storage/gschpt.db
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GSCHPT_STORAGE_DIR=./generated_drafts
GSCHPT_PRIVATE_STORAGE_DIR=./storage/private
